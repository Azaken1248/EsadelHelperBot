# ═══════════════════════════════════════
# Required — Bot will not start without these
# ═══════════════════════════════════════
DISCORD_TOKEN=your-bot-token-here
DISCORD_APPLICATION_ID=your-application-id-here
GUILD_ID=your-guild-server-id-here
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/esadel-bot

# ═══════════════════════════════════════
# Channels — Optional, features disabled if unset
# ═══════════════════════════════════════
APPROVAL_CHANNEL_ID=
REMINDERS_CHANNEL_ID=
LOGS_CHANNEL_ID=
VERIFICATION_CHANNEL_ID=

# ═══════════════════════════════════════
# Structural Roles — Replace with Esadel server role IDs
# ═══════════════════════════════════════
ROLE_OWNER_ID=
ROLE_MOD_ID=
ROLE_CREW_ID=
ROLE_UNVERIFIED_ID=

# ═══════════════════════════════════════
# Specialized Roles — Add per Esadel's team structure
# ═══════════════════════════════════════
# ROLE_ARTIST_ID=
# ROLE_EDITOR_ID=
# ... add as needed

# ═══════════════════════════════════════
# Anti-Bot Verification Gating (reCAPTCHA v2 / hCaptcha)
# ═══════════════════════════════════════
CAPTCHA_SITE_KEY=your-captcha-site-key
CAPTCHA_SECRET_KEY=your-captcha-secret-key
WEB_PORTAL_URL=https://esadel.azaken.com

# ═══════════════════════════════════════
# Web Portal / HTTP API Settings
# The API only starts when ANALYTICS_JWT_SECRET is set. Use a long random value
# (e.g. `openssl rand -base64 48`) — the bot warns on weak/placeholder secrets.
# ═══════════════════════════════════════
WEBSITE_PORT=3000
ANALYTICS_JWT_SECRET=your-analytics-jwt-secret
# Comma-separated allow-list of browser origins for the dashboard.
# Empty (default) = no cross-origin browser access.
# API_CORS_ORIGINS=https://dashboard.example.com
# API_RATE_LIMIT_PER_MINUTE=60

# ═══════════════════════════════════════
# Reminder System — Defaults are usually fine
# ═══════════════════════════════════════
REMINDERS_ENABLED=true
REMINDER_OFFSETS_MINUTES=1440,360,60,0
# REMINDER_POLL_INTERVAL_MS=30000
# REMINDER_BATCH_SIZE=25
# REMINDER_LOCK_DURATION_MS=60000
# REMINDER_MAX_ATTEMPTS=5

# ═══════════════════════════════════════
# Logging
# ═══════════════════════════════════════
# Emit each log entry as a JSON line on stdout (for Loki/Vector/Fluent Bit).
# LOG_STREAM_JSON=true

# ═══════════════════════════════════════
# Local LLM (optional) — powers a conversational /ask via a LOCAL Ollama server.
# When disabled, /ask stays offline retrieval-only. No cloud, no API cost.
# ═══════════════════════════════════════
# Master switch (enables both capabilities):
# LLM_ENABLED=true
#
# Or enable them independently. Embeddings are cheap (one forward pass) and
# power semantic memory recall; generation is expensive on CPU-only hosts.
# LLM_EMBEDDINGS_ENABLED=true
# LLM_GENERATION_ENABLED=false
#
# --- Provider: "ollama" (local, default) or "openai" (any OpenAI-compatible API) ---
# LLM_PROVIDER=ollama
#
# ollama provider:
# OLLAMA_BASE_URL=http://localhost:11434   # can point at another machine
# LLM_MODEL=llama3.2:3b
# LLM_EMBED_MODEL=nomic-embed-text
#
# openai provider — works with Google Gemini, Groq, OpenRouter, Cerebras, ...
# Google Gemini (free tier):
# LLM_PROVIDER=openai
# LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=your-google-ai-studio-key
# LLM_MODEL=gemini-2.5-flash
# LLM_EMBED_MODEL=text-embedding-004
#
# Groq (free tier, very fast):
# LLM_API_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
#
# LLM_TIMEOUT_MS=20000
#
# Grounding context sent to the model. Prompt processing dominates cost on slow
# CPUs, so keep these small there (2 x 600 is already conservative).
# LLM_MAX_CONTEXT_ENTRIES=2
# LLM_MAX_CONTEXT_CHARS_PER_ENTRY=600

# ═══════════════════════════════════════
# Extension Rules
# ═══════════════════════════════════════
# MAX_STANDARD_EXTENSIONS=
BLOCK_TIME_LIMITED_AUTO_EXTENSION=true
